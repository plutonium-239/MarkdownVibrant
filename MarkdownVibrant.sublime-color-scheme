{
  "name": "Markdown Vibrant Neon",
  "author": "Sublime Markdown Vibrant",
  "variables": {
    "bg": "#0f111a",
    "fg": "#f0f4fc",
    "caret": "#00f5d4",
    "line_highlight": "#1a1d2e",
    "selection": "#323859",
    "comment": "#6b7280",

    "h1": "#ff007f",
    "h2": "#bd93f9",
    "h3": "#00f5d4",
    "h4": "#50fa7b",
    "h5": "#ffb86c",
    "h6": "#ff5555",

    "bold": "#ff79c6",
    "italic": "#8be9fd",
    "code": "#f1fa8c",
    "code_bg": "#1e2238",
    "quote": "#00e5ff",
    "link": "#bd93f9",
    "url": "#38ef7d",
    "list_bullet": "#ff922b",
    "table": "#00f5d4",
    "checkbox_done": "#50fa7b",
    "checkbox_todo": "#ff5555"
  },
  "globals": {
    "background": "var(bg)",
    "foreground": "var(fg)",
    "caret": "var(caret)",
    "line_highlight": "var(line_highlight)",
    "selection": "var(selection)",
    "active_guide": "#00f5d4",
    "find_highlight": "#ff007f",
    "find_highlight_foreground": "#ffffff"
  },
  "rules": [
    {
      "name": "Markdown Heading General",
      "scope": "markup.heading, entity.name.section.markdown",
      "font_style": "bold"
    },
    {
      "name": "Markdown Heading 1",
      "scope": "markup.heading.1, markup.heading.1.markdown, markup.heading.1 entity.name.section.markdown",
      "foreground": "var(h1)",
      "font_style": "bold"
    },
    {
      "name": "Markdown Heading 2",
      "scope": "markup.heading.2, markup.heading.2.markdown, markup.heading.2 entity.name.section.markdown",
      "foreground": "var(h2)",
      "font_style": "bold"
    },
    {
      "name": "Markdown Heading 3",
      "scope": "markup.heading.3, markup.heading.3.markdown, markup.heading.3 entity.name.section.markdown",
      "foreground": "var(h3)",
      "font_style": "bold"
    },
    {
      "name": "Markdown Heading 4",
      "scope": "markup.heading.4, markup.heading.4.markdown, markup.heading.4 entity.name.section.markdown",
      "foreground": "var(h4)",
      "font_style": "bold"
    },
    {
      "name": "Markdown Heading 5",
      "scope": "markup.heading.5, markup.heading.5.markdown, markup.heading.5 entity.name.section.markdown",
      "foreground": "var(h5)",
      "font_style": "bold"
    },
    {
      "name": "Markdown Heading 6",
      "scope": "markup.heading.6, markup.heading.6.markdown, markup.heading.6 entity.name.section.markdown",
      "foreground": "var(h6)",
      "font_style": "bold"
    },
    {
      "name": "Markdown Heading Punctuation",
      "scope": "punctuation.definition.heading, punctuation.definition.heading.markdown",
      "font_style": "bold"
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold, markup.bold.markdown",
      "foreground": "var(bold)",
      "font_style": "bold"
    },
    {
      "name": "Markdown Italic",
      "scope": "markup.italic, markup.italic.markdown",
      "foreground": "var(italic)",
      "font_style": "italic"
    },
    {
      "name": "Markdown Strikethrough",
      "scope": "markup.strikethrough, markup.strikethrough.markdown",
      "foreground": "var(comment)"
    },
    {
      "name": "Markdown Inline Code",
      "scope": "markup.inline.raw, markup.inline.raw.string.markdown, markup.raw.inline.markdown",
      "foreground": "var(code)",
      "background": "var(code_bg)"
    },
    {
      "name": "Markdown Fenced Code Block",
      "scope": "markup.raw.block, markup.raw.code-fence",
      "foreground": "#f8f8f2",
      "background": "var(code_bg)"
    },
    {
      "name": "Markdown Code Fence Punctuation",
      "scope": "punctuation.definition.raw.code-fence.markdown",
      "foreground": "#6272a4"
    },
    {
      "name": "Markdown Code Fence Language Identifier",
      "scope": "constant.other.language-name.markdown",
      "foreground": "var(italic)",
      "font_style": "bold"
    },
    {
      "name": "Markdown Blockquote",
      "scope": "markup.quote, markup.quote.markdown",
      "foreground": "var(quote)",
      "font_style": "italic"
    },
    {
      "name": "Markdown List Bullet / Number",
      "scope": "punctuation.definition.list_item, punctuation.definition.list_item.markdown, markup.list.numbered.bullet.markdown",
      "foreground": "var(list_bullet)",
      "font_style": "bold"
    },
    {
      "name": "Markdown Link Text",
      "scope": "string.other.link.title, string.other.link.title.markdown, string.other.link.description.markdown",
      "foreground": "var(link)",
      "font_style": "bold"
    },
    {
      "name": "Markdown Link URL",
      "scope": "markup.underline.link, markup.underline.link.markdown, meta.link.inline.markdown punctuation.definition.metadata.markdown",
      "foreground": "var(url)"
    },
    {
      "name": "Markdown Table",
      "scope": "markup.other.table, markup.other.table.markdown, punctuation.definition.table.markdown",
      "foreground": "var(table)"
    },
    {
      "name": "Markdown Checkbox Done",
      "scope": "punctuation.definition.checkbox.checked.markdown, meta.checkbox.checked.markdown",
      "foreground": "var(checkbox_done)",
      "font_style": "bold"
    },
    {
      "name": "Markdown Checkbox Todo",
      "scope": "punctuation.definition.checkbox.unchecked.markdown, meta.checkbox.unchecked.markdown",
      "foreground": "var(checkbox_todo)",
      "font_style": "bold"
    },
    {
      "name": "Markdown Horizontal Rule",
      "scope": "meta.separator, meta.separator.markdown, punctuation.definition.metadata.markdown",
      "foreground": "#bd93f9",
      "font_style": "bold"
    },
    {
      "name": "Comment",
      "scope": "comment",
      "foreground": "#6272a4",
      "font_style": "italic"
    },
    {
      "name": "String",
      "scope": "string",
      "foreground": "var(code)"
    },
    {
      "name": "Escape Sequence / Symbol",
      "scope": "constant.character.escape, constant.other.symbol",
      "foreground": "var(code)"
    },
    {
      "name": "Constant",
      "scope": "constant.numeric, constant.language, constant.character",
      "foreground": "var(h2)"
    },
    {
      "name": "Keyword / Storage",
      "scope": "keyword, storage",
      "foreground": "var(bold)"
    },
    {
      "name": "Operator",
      "scope": "keyword.operator",
      "foreground": "var(italic)"
    },
    {
      "name": "Function Name",
      "scope": "entity.name.function, support.function, meta.function-call",
      "foreground": "var(h4)"
    },
    {
      "name": "Type / Class / Tag",
      "scope": "entity.name.type, entity.name.class, support.class, support.type, entity.name.tag",
      "foreground": "var(italic)"
    },
    {
      "name": "Attribute Name",
      "scope": "entity.other.attribute-name",
      "foreground": "var(h5)"
    },
    {
      "name": "Variable (Parameter / Language)",
      "scope": "variable.parameter, variable.language",
      "foreground": "var(h5)",
      "font_style": "italic"
    },
    {
      "name": "Punctuation (Definition / Separator)",
      "scope": "punctuation.definition, punctuation.separator",
      "foreground": "#f8f8f2"
    }
  ]
}
